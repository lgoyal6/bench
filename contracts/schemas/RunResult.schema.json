{
  "$defs": {
    "Commit": {
      "properties": {
        "repo": {
          "description": "Git URL the rig pulls from",
          "title": "Repo",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{7,40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "sha"
      ],
      "title": "Commit",
      "type": "object"
    },
    "Contestant": {
      "properties": {
        "agent": {
          "description": "e.g. 'devin', 'step-5-preview', 'veri-open-model'",
          "title": "Agent",
          "type": "string"
        },
        "model": {
          "description": "e.g. 'opus', 'swe', 'gpt'; same as agent when not applicable",
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "model"
      ],
      "title": "Contestant",
      "type": "object"
    },
    "FaultEvent": {
      "properties": {
        "at_ms": {
          "description": "Offset from run start",
          "minimum": 0,
          "title": "At Ms",
          "type": "number"
        },
        "kind": {
          "enum": [
            "kill_driver",
            "stop_sensor",
            "cpu_hog",
            "corrupt_bytes"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "description": "Process, sensor or bus name, e.g. 'servo_driver'",
          "title": "Target",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None means instantaneous",
          "title": "Duration Ms"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "at_ms",
        "kind",
        "target"
      ],
      "title": "FaultEvent",
      "type": "object"
    },
    "FaultSchedule": {
      "properties": {
        "schedule_id": {
          "title": "Schedule Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "author": {
          "description": "Agentverse address of the agent that wrote it",
          "title": "Author",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/FaultEvent"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "schedule_id",
        "task_id",
        "author",
        "events"
      ],
      "title": "FaultSchedule",
      "type": "object"
    },
    "Metrics": {
      "properties": {
        "trials": {
          "minimum": 0,
          "title": "Trials",
          "type": "integer"
        },
        "deadline_hit_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Deadline Hit Rate",
          "type": "number"
        },
        "worst_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worst Latency Ms"
        },
        "p99_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P99 Latency Ms"
        },
        "false_triggers": {
          "default": 0,
          "minimum": 0,
          "title": "False Triggers",
          "type": "integer"
        },
        "fault_survived": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fault Survived"
        },
        "extra": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Task-specific metrics",
          "title": "Extra",
          "type": "object"
        }
      },
      "required": [
        "trials",
        "deadline_hit_rate"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "RunRequest": {
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "contestant": {
          "$ref": "#/$defs/Contestant"
        },
        "commit": {
          "$ref": "#/$defs/Commit"
        },
        "seed": {
          "description": "Drives stimulus timing, directions and silent rounds",
          "title": "Seed",
          "type": "integer"
        },
        "fault_schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/FaultSchedule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stated_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stated Confidence"
        }
      },
      "required": [
        "task_id",
        "contestant",
        "commit",
        "seed"
      ],
      "title": "RunRequest",
      "type": "object"
    }
  },
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "rig_id": {
      "description": "Which QNX rig ran it, e.g. 'rig-1'",
      "title": "Rig Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/RunRequest"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "error"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "verdict_reason": {
      "title": "Verdict Reason",
      "type": "string"
    },
    "trace_uri": {
      "description": "Raw QNX kernel trace, required for every verdict",
      "title": "Trace Uri",
      "type": "string"
    },
    "imu_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "StackChan IMU stream for behavior tasks",
      "title": "Imu Uri"
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "IDs proving real services were used. Known keys: devin_session_url, stepfun_request_id, elevenlabs_manifest, sentry_trace_id, tigerdata_row, snowflake_row, payment_id",
      "title": "Provenance",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "rig_id",
    "request",
    "started_at",
    "finished_at",
    "metrics",
    "verdict",
    "verdict_reason",
    "trace_uri"
  ],
  "title": "RunResult",
  "type": "object"
}

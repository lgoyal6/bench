{
  "$defs": {
    "Commit": {
      "properties": {
        "repo": {
          "description": "Git URL the rig pulls from",
          "title": "Repo",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{7,40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "sha"
      ],
      "title": "Commit",
      "type": "object"
    },
    "Contestant": {
      "properties": {
        "agent": {
          "description": "e.g. 'devin', 'step-5-preview', 'veri-open-model'",
          "title": "Agent",
          "type": "string"
        },
        "model": {
          "description": "e.g. 'opus', 'swe', 'gpt'; same as agent when not applicable",
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "model"
      ],
      "title": "Contestant",
      "type": "object"
    },
    "FaultEvent": {
      "properties": {
        "at_ms": {
          "description": "Offset from run start",
          "minimum": 0,
          "title": "At Ms",
          "type": "number"
        },
        "kind": {
          "enum": [
            "kill_driver",
            "stop_sensor",
            "cpu_hog",
            "corrupt_bytes"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "description": "Process, sensor or bus name, e.g. 'servo_driver'",
          "title": "Target",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None means instantaneous",
          "title": "Duration Ms"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "at_ms",
        "kind",
        "target"
      ],
      "title": "FaultEvent",
      "type": "object"
    },
    "FaultSchedule": {
      "properties": {
        "schedule_id": {
          "title": "Schedule Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "author": {
          "description": "Agentverse address of the agent that wrote it",
          "title": "Author",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/FaultEvent"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "schedule_id",
        "task_id",
        "author",
        "events"
      ],
      "title": "FaultSchedule",
      "type": "object"
    }
  },
  "properties": {
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "contestant": {
      "$ref": "#/$defs/Contestant"
    },
    "commit": {
      "$ref": "#/$defs/Commit"
    },
    "seed": {
      "description": "Drives stimulus timing, directions and silent rounds",
      "title": "Seed",
      "type": "integer"
    },
    "fault_schedule": {
      "anyOf": [
        {
          "$ref": "#/$defs/FaultSchedule"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stated_confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stated Confidence"
    }
  },
  "required": [
    "task_id",
    "contestant",
    "commit",
    "seed"
  ],
  "title": "RunRequest",
  "type": "object"
}
